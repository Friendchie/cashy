{
  "loggerConsoleOutput": true,
  "loggerLevel": "info",
  "httpDownloadConcurrency": 3,
  "httpConnectionTimeoutMs": 10000,
  "serve": {
    "load": {
      "lazy": true,
      "concurrency": 2,
      "cancelOnDisconnect": false
    },
    "models": {
      "salamandra-2b": {
        "model": "SALAMANDRATA_2B_INST_Q4",
        "default": true,
        "preload": false
      },
      "llama-3.2-1b": {
        "model": "LLAMA_3_2_1B_INST_Q4_0",
        "default": false,
        "preload": false
      },
      "bitnet-3b": {
        "model": "BITNET_B1_58_3B_INST_TQ2_0",
        "default": false,
        "preload": false
      }
    }
  }
}

